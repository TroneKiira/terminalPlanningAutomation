                <chunk name="Container">
                  <items count="4">
                    <item name="Description" type_name="gh_string" type_code="10">Arrival show-up curve for a passenger type across the hour before departure. Leisure, Business and Mix presets, or a custom W15/W30/W60 fit.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">a5f60a5d-ce2a-4441-b89f-076437a78e02</item>
