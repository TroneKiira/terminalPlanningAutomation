                    <chunk name="param_input" index="8">
                      <items count="8">
                        <item name="Access" type_name="gh_int32" type_code="3">1</item>
                        <item name="Description" type_name="gh_string" type_code="10">Optional keyed pool plans (Pool Plans component). In single-stage mode they define each pool's nominal resources, target wait and resource domain; in series mode use the identities 'EGate' and 'ATRS'.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">1a693555-1779-412f-a9e5-35144ceecd0e</item>
