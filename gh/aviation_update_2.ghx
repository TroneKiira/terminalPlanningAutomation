              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="5">
                    <item name="Description" type_name="gh_string" type_code="10">Explains how the queuing model works on a real run: cumulative arrivals against departures (the gap is the queue), or queue length over time.</item>
                    <item name="Hidden" type_name="gh_bool" type_code="1">true</item>
